tosca_definitions_version: 2.0
imports:
- url: NodeTypeTest.yml
- url: cloud_native_deployment_DeploymentOptions/types/node_types.yaml

node_types:
  cna-modeling.entities.Infrastructure:
    derived_from: Abstract.Compute
    description: Node Type to model Infrastructure entities
    properties:
      kind:
        type: string
        description: The kind of infrastructure. Possible kinds are "physical hardware", "virtual hardware", "software platform", or "cloud service".
        required: true
        validation: { $valid_values: [ $value, [ "physical-hardware", "virtual-hardware", "software-platform", "cloud-service"]]}
        default: virtual-hardware
        
service_template:
  node_templates:
    aws_fargate:
      type: cna-modeling.entities.Infrastructure
      metadata:
        label: AWS Fargate
        fontSize: '14'
        size_width: '800'
        size_height: '90'
        position_xCoord: '530'
        position_yCoord: '1400'
      properties:
        kind: cloud-service
      