tosca_definitions_version: 2.0
imports:
- url: NodeTypeTest.yml

service_template:
  node_templates:
    my_application:
      type: WebApplication
      count: 3
      properties:
        testProperty:
          description: >-
            Identifies the virtualization environments (e.g. hypervisor) compatible with this software
            image.
          type: integer
          value: 500
          validation: { $less_or_equal: [ $value, 500 ] }
      
      requirements:
        - provides_endpoint:
            capability: Endpoint
            node: sql
            relationship: cna-modeling.relationships.Provides.Endpoint
